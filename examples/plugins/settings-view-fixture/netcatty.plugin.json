{
  "manifestVersion": 1,
  "id": "com.netcatty.settings-view-fixture",
  "name": "settings-view-fixture",
  "displayName": { "en": "Settings View QA", "zh-CN": "设置视图验收" },
  "version": "0.1.1",
  "publisher": "netcatty",
  "license": "GPL-3.0-or-later",
  "engines": { "netcatty": ">=0.0.0", "api": ">=0.1.0-internal <0.2.0" },
  "main": { "browser": "index.js" },
  "activationEvents": ["onView:com.netcatty.settings-view-fixture.panel"],
  "permissions": { "required": ["views"] },
  "contributes": {
    "views": [{
      "id": "com.netcatty.settings-view-fixture.panel",
      "title": { "en": "Static Settings View", "zh-CN": "静态设置视图" },
      "location": "settings",
      "entry": "view.html"
    }]
  }
}
